# Copy to .env and adjust if needed, then `docker compose up --build`.

# Where the backend can reach your Ollama instance running GLM-OCR.
# host.docker.internal works out of the box on Docker Desktop (Mac/Windows).
OLLAMA_URL=http://host.docker.internal:11434

# The Ollama model tag you pulled/created for GLM-OCR.
OCR_MODEL=glm-ocr

# Rendering DPI when converting PDF pages to images before OCR.
OCR_DPI=220

# Context window and max output tokens given to the model per page.
# Raise these if pages are still getting cut off.
OCR_NUM_CTX=8192
OCR_NUM_PREDICT=4096

# Seconds to wait for a single page OCR call before giving up.
OCR_TIMEOUT=300
